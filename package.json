{
  "name": "grag-monorepo",
  "private": true,
  "description": "Monorepo for @farming-labs/grag and its documentation site.",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "pnpm build:package && pnpm build:docs",
    "build:package": "pnpm --filter @farming-labs/grag build",
    "build:docs": "pnpm --filter @farming-labs/grag-docs build",
    "check": "pnpm --filter @farming-labs/grag check && pnpm --filter @farming-labs/grag-docs check",
    "dev": "pnpm --filter @farming-labs/grag-docs dev",
    "docs:dev": "pnpm --filter @farming-labs/grag-docs dev",
    "test": "pnpm --filter @farming-labs/grag test"
  }
}
