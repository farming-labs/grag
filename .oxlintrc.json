{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "noUnusedVariables": "warn"
  },
  "ignorePatterns": [
    "node_modules/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/build/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/*.css",
    "**/*.mdx",
    "**/*.md"
  ]
}
